# Dependencies and package-manager state
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# Build and runtime output
**/coverage/
**/.next/
**/out/
**/dist/
**/.wrangler/
**/.sites-runtime/
**/outputs/
**/work/

# Local environment and credentials
**/.env
**/.env.*
!**/.env.example
**/*.pem

# Logs and local editor files
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/.DS_Store
**/.vercel/
**/next-env.d.ts
