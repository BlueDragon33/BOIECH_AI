DEVICE_ADMIN_EMAILS=owner@example.com

# App-scoped server secret shared only with canonical Application Management.
CONTROL_SERVICE_SECRET=replace-with-a-shared-secret-of-at-least-32-characters

# Exact control-plane origin. Cloudflare preview/production must use HTTPS.
# Local loopback HTTP is accepted only when LOCAL_CONTROL_PLANE=true.
APPLICATION_MANAGEMENT_ORIGIN=https://application-management.example.com
LOCAL_CONTROL_PLANE=false
LOCAL_CONTROL_ALLOW_LAN=false

# Optional local-only D1 identity used by Miniflare/Vite; never use the production D1 ID here.
BOI_ECH_LOCAL_DATABASE_ID=00000000-0000-0000-0000-000000000004
